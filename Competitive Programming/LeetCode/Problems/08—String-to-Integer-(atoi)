class Solution {
    public int myAtoi(String s) {
        if (s == null || s.length() == 0) return 0;
        
        int n = s.length();
        int i = 0;
        
        // 1. Skip leading whitespace
        while (i < n && s.charAt(i) == ' ') {
            i++;
        }
        
        if (i == n) return 0;
        
        // 2. Handle sign
        int sign = 1;
        if (s.charAt(i) == '-') {
            sign = -1;
            i++;
        } else if (s.charAt(i) == '+') {
            i++;
        }
        
        // 3. Convert digits
        int result = 0;
        int maxDiv10 = Integer.MAX_VALUE / 10;
        
        while (i < n) {
            char c = s.charAt(i);
            if (c < '0' || c > '9') break;
            
            int digit = c - '0';
            
            // 4. Check for overflow before multiplying
            if (result > maxDiv10 || (result == maxDiv10 && digit > 7)) {
                return sign == 1 ? Integer.MAX_VALUE : Integer.MIN_VALUE;
            }
            
            result = result * 10 + digit;
            i++;
        }
        
        return sign * result;
    }
}
